generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                   Int      @id @default(autoincrement())
  nombre               String
  email                String   @unique
  telefono             String?
  passwordHash         String   @map("password_hash")
  activo               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  roles     UsuarioRol[]
  sesiones  Sesion[]
  reservas  Reserva[]
  favoritos Favorito[]
  mensajes  Mensaje[]

  dispositivosWearable DispWearable[]
  vinculacionesWearable VinculacionWearable[]
  notificaciones       Notificacion[]

  @@map("usuarios")
}

enum EstadoReserva {
  pendiente
  confirmada
  completada
  cancelada

  @@map("estado_reserva")
}

model Sala {
  id          String   @id
  nombre      String
  precio      Int
  capacidad   Int
  m2          Int
  badge       String
  badgeLabel  String   @map("badge_label")
  featured    Boolean  @default(false)
  descripcion String
  equipo      String[]
  imagenUrl   String?  @map("imagen_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  reservas  Reserva[]
  favoritos Favorito[]

  @@map("salas")
}

model Reserva {
  id              String        @id @default(uuid())
  usuarioId       Int           @map("usuario_id")
  salaId          String        @map("sala_id")
  fecha           String
  hora            String
  duracionHoras   Int           @map("duracion_horas")
  precioSala      Int           @map("precio_sala")
  servicios       Json
  precioServicios Int           @map("precio_servicios")
  precioTotal     Int           @map("precio_total")
  estado          EstadoReserva @default(confirmada)
  notas           String?
  creadoEn        DateTime      @default(now()) @map("creado_en")

  // Evita que el recordatorio automático se envíe más de una vez.
  recordatorioEnviado Boolean   @default(false) @map("recordatorio_enviado")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sala    Sala    @relation(fields: [salaId], references: [id], onDelete: Cascade)
  @@map("reservas")
}

model Favorito {
  usuarioId Int      @map("usuario_id")
  salaId    String   @map("sala_id")
  creadoEn  DateTime @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sala    Sala    @relation(fields: [salaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, salaId])
  @@map("favoritos")
}

enum OrigenMensaje {
  contacto
  soporte

  @@map("origen_mensaje")
}

enum EstadoMensaje {
  nuevo
  respondido

  @@map("estado_mensaje")
}

model Mensaje {
  id        String        @id @default(uuid())
  nombre    String
  email     String
  asunto    String
  mensaje   String
  origen    OrigenMensaje
  usuarioId Int?          @map("usuario_id")
  estado    EstadoMensaje @default(nuevo)
  creadoEn  DateTime      @default(now()) @map("creado_en")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("mensajes")
}

model Rol {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  createdAt   DateTime @default(now()) @map("created_at")

  usuarios UsuarioRol[]
  permisos RolPermiso[]

  @@map("roles")
}

model Permiso {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolPermiso[]

  @@map("permisos")
}

model UsuarioRol {
  usuarioId Int @map("usuario_id")
  rolId     Int @map("rol_id")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  asignadoEn DateTime @default(now()) @map("asignado_en")

  @@id([usuarioId, rolId])
  @@map("usuario_rol")
}

model RolPermiso {
  rolId     Int @map("rol_id")
  permisoId Int @map("permiso_id")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("rol_permiso")
}

model Sesion {
  id           Int      @id @default(autoincrement())
  usuarioId    Int      @map("usuario_id")
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ip           String?
  valida       Boolean  @default(true)
  expiraEn     DateTime @map("expira_en")
  createdAt    DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("sesiones")
}

// ───────────────────────────────────────────────────────────────
//  Null Pointer Wear — dispositivos wearable y notificaciones
// ───────────────────────────────────────────────────────────────

enum TipoNotificacion {
  reserva_confirmada
  reserva_cancelada
  recordatorio_reserva
  cambio_sala_favorita

  @@map("tipo_notificacion")
}

// Reloj vinculado a la cuenta de un Usuario.
// - tokenHash: credencial propia del reloj (se guarda solo el hash SHA-256).
// - fcmToken: token de Firebase Cloud Messaging para enviar notificaciones push.
model DispWearable {
  id           Int       @id @default(autoincrement())
  usuarioId    Int       @map("usuario_id")
  nombre       String
  modelo       String?
  plataforma   String    @default("wear_os")
  tokenHash    String    @unique @map("token_hash")
  fcmToken     String?   @unique @map("fcm_token")
  activo       Boolean   @default(true)
  ultimoAcceso DateTime? @map("ultimo_acceso")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("disp_wearables")
}

// Código temporal de vinculación (flujo tipo "device code"):
// el reloj muestra un código de 6 dígitos y el Usuario lo confirma desde la web.
model VinculacionWearable {
  id             String    @id @default(uuid())
  codigo         String
  deviceCodeHash String    @unique @map("device_code_hash")
  nombre         String
  modelo         String?
  usuarioId      Int?      @map("usuario_id")
  confirmadaEn   DateTime? @map("confirmada_en")
  consumida      Boolean   @default(false)
  expiraEn       DateTime  @map("expira_en")
  createdAt      DateTime  @default(now()) @map("created_at")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([codigo])
  @@map("vinculaciones_wearable")
}

// Historial de avisos. El reloj los consulta (y los recibe por push si FCM está configurado).
model Notificacion {
  id          String           @id @default(uuid())
  usuarioId   Int              @map("usuario_id")
  tipo        TipoNotificacion
  titulo      String
  cuerpo      String
  datos       Json?
  leida       Boolean          @default(false)
  enviadaPush Boolean          @default(false) @map("enviada_push")
  creadoEn    DateTime         @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, creadoEn])
  @@map("notificaciones")
}
