generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  telefono     String?
  passwordHash String   @map("password_hash")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles     UsuarioRol[]
  sesiones  Sesion[]
  reservas  Reserva[]
  favoritos Favorito[]

  @@map("usuarios")
}

enum EstadoReserva {
  pendiente
  confirmada
  completada
  cancelada

  @@map("estado_reserva")
}

model Sala {
  id          String   @id
  nombre      String
  precio      Int
  capacidad   Int
  m2          Int
  badge       String
  badgeLabel  String   @map("badge_label")
  featured    Boolean  @default(false)
  descripcion String
  equipo      String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  reservas  Reserva[]
  favoritos Favorito[]

  @@map("salas")
}

model Reserva {
  id              String        @id @default(uuid())
  usuarioId       Int           @map("usuario_id")
  salaId          String        @map("sala_id")
  fecha           String
  hora            String
  duracionHoras   Int           @map("duracion_horas")
  precioSala      Int           @map("precio_sala")
  servicios       Json
  precioServicios Int           @map("precio_servicios")
  precioTotal     Int           @map("precio_total")
  estado          EstadoReserva @default(confirmada)
  notas           String?
  creadoEn        DateTime      @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sala    Sala    @relation(fields: [salaId], references: [id], onDelete: Cascade)

  @@map("reservas")
}

model Favorito {
  usuarioId Int      @map("usuario_id")
  salaId    String   @map("sala_id")
  creadoEn  DateTime @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sala    Sala    @relation(fields: [salaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, salaId])
  @@map("favoritos")
}

model Rol {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  createdAt   DateTime @default(now()) @map("created_at")

  usuarios UsuarioRol[]
  permisos RolPermiso[]

  @@map("roles")
}

model Permiso {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolPermiso[]

  @@map("permisos")
}

model UsuarioRol {
  usuarioId Int @map("usuario_id")
  rolId     Int @map("rol_id")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  asignadoEn DateTime @default(now()) @map("asignado_en")

  @@id([usuarioId, rolId])
  @@map("usuario_rol")
}

model RolPermiso {
  rolId     Int @map("rol_id")
  permisoId Int @map("permiso_id")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("rol_permiso")
}

model Sesion {
  id           Int      @id @default(autoincrement())
  usuarioId    Int      @map("usuario_id")
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ip           String?
  valida       Boolean  @default(true)
  expiraEn     DateTime @map("expira_en")
  createdAt    DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("sesiones")
}
